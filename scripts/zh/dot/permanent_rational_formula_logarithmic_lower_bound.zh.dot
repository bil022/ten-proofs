digraph G {
	graph [nodesep=0.25,
		rankdir=LR,
		ranksep=0.6
	];
	node [fontname=Helvetica,
		fontsize=11,
		shape=box,
		style="filled,rounded"
	];
	edge [arrowsize=0.7,
		color="#8a8a8a"
	];
	"MatchingCrossData.assemble_cols"	[label="匹配交叉数据 · 组装 列\nMatchingCrossData.assemble_cols", fillcolor="#cfe8ff"];
	"MatchingCrossData.assemble_ofPermutation"	[label="匹配交叉数据 · 组装 由置换\nMatchingCrossData.assemble_ofPermutation", fillcolor="#cfe8ff"];
